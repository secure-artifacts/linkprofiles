# 服务器上的部署配置。复制成 .env 填好，然后把权限收到 600：
#
#     cp .env.example .env && chmod 600 .env
#
# 里面有数据库密码与超管初始密码，这个文件已经在 .gitignore 里，不会被提交。
# 每一项怎么填见 运维部署手册.md 第 2 步。

# ── 必填 ────────────────────────────────────────────────────────────
# 用哪个镜像跑。在服务器上自己 build 的话就填 link-profile:local；
# 以后由 GitLab CI 推到镜像仓库了，就填 registry 地址加标签。
APP_IMAGE=link-profile:local

# 数据库密码。会被直接拼进连接串，因此**只能用字母数字**，别用 / ? # @ 这类字符。
# 生成一个：openssl rand -hex 32
POSTGRES_PASSWORD=

# 首次启动据此创建超级管理员。库里已有超管则整段跳过 —— 改这里不会重置线上密码。
SUPERADMIN_ACCOUNT=admin
SUPERADMIN_PASSWORD=

# 站点对外地址，带协议、不带尾斜杠。分享卡片里的绝对地址取自它。
PUBLIC_ORIGIN=https://links.example.com

# 反向代理的实际源地址。
#
# 应用在容器里，看到的源地址是 compose 网络的网关，既不是 loopback，也不是 docker0
# 的 172.17.0.1 —— loopback 与 hop-count 写法都不生效，必须写实际网关。
#
# 现场网段写进 docker-compose.override.yml；这里与最终生效的 gateway 一致。
#
# 配错不会报错，只会让访客 IP 全部记成内网网关地址。验法见手册 2.6 的最后一项。
TRUST_PROXY=172.28.0.1

# ── 可选 ────────────────────────────────────────────────────────────
# 反代到应用的映射端口。只绑 127.0.0.1，不对外暴露。
APP_PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 地域库。应用不会自动下载，不放的话国家和城市全部是「未知」。下载与每月更新见手册 2.2 末尾与「日常维护」。
# HOST_DIR 是宿主机目录，放在部署目录之外；CITY_PATH 是容器里的路径，只打开这一个文件，不扫目录。
# 改了这两行要 docker compose up -d 重建容器，restart 不会读新的环境变量。
GEOLITE2_HOST_DIR=/var/lib/link-profile/geoip
GEOLITE2_CITY_PATH=/app/geoip/city.mmdb

# 只读 SQL 排查接口 POST /_api/debug/query 的令牌。
#
# 正常由 GitLab CI 的变量 DEBUG_QUERY_TOKEN 注入到 `docker compose up` 的环境里，
# 这里不用填；shell 环境里的值优先于本文件。手工部署、想让令牌跟着服务器走的话填这里。
# 两处都没有，或长度不足 24 字符，接口就不放行任何请求，排查接口全部返回 401。
#   openssl rand -hex 32
DEBUG_QUERY_TOKEN=

# ── 以下由镜像内置，不要在这里设置 ──────────────────────────────────
# HOST / PORT / NODE_ENV / MIGRATIONS_DIR / ADMIN_DIST / UPLOADS_DIR / FONT_DIR
