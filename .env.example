# 部署配置。复制成 .env 后填写，并把权限收到 600 —— 里面是数据库密码与超管初始密码。
# 完整说明见 docs/deployment.md。

# ── 必填 ────────────────────────────────────────────────────────────
# 数据库密码。会被直接拼进连接串，因此只能用字母数字，别用 / ? # @ 这类字符。
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# 首次启动据此创建超级管理员。库里已有超管则整段跳过 —— 改这里不会重置线上密码。
SUPERADMIN_ACCOUNT=admin
SUPERADMIN_PASSWORD=

# 站点对外地址，带协议、不带尾斜杠。分享卡片里的绝对地址取自它。
PUBLIC_ORIGIN=https://links.example.com

# 反向代理的实际源地址，逗号分隔的 IP / CIDR。
#
# 应用在容器里，看到的源地址是 compose 网络的网关，既不是 loopback，也不是 docker0
# 的 172.17.0.1 —— 实测 loopback 与 hop-count 写法均不生效，必须写实际网关。
#
# 下面这个值与 docker-compose.yml 里 networks.default.ipam 的 gateway 一一对应，
# 网段写死就是为了让它稳定。**改了那边就要改这里**，两边必须一致。
#
# 配错不会报错，只会让访客 IP 全部记成内网网关地址。验收方法见 docs/deployment.md。
TRUST_PROXY=172.28.0.1

# ── 可选 ────────────────────────────────────────────────────────────
# 反代到应用的映射端口。只绑 127.0.0.1，不对外暴露。
APP_PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# GeoIP。放置兼容 MaxMind 格式的城市 MMDB；缺失时地域维度为空。
GEOLITE2_HOST_DIR=./geoip
GEOLITE2_CITY_PATH=/app/geoip/GeoIP-City.mmdb

# ── 以下由镜像内置，正常部署不需要设置 ──────────────────────────────
# HOST=0.0.0.0
# PORT=3000
# NODE_ENV=production        设为 production 后 session cookie 带 Secure，必须走 HTTPS
# MIGRATIONS_DIR=/app/drizzle
# ADMIN_DIST=/app/public/_admin
# UPLOADS_DIR=/app/uploads
# FONT_DIR=/app/fonts

# ── 仅本地开发与 CI ─────────────────────────────────────────────────
# DATABASE_URL=postgres://linkprofile:linkprofile@localhost:5432/link_profile
# 测试库。每个测试文件在其中开一个独立 schema，跑完 drop
# TEST_DATABASE_URL=postgres://linkprofile:linkprofile@localhost:5432/link_profile_test
